# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE / editor tooling
.idea/
.cursor/

# Data files: ignore everything in Projects/*/data/ (keep data/.gitkeep)
*.sqlite
Projects/*/data/*
!Projects/*/data/.gitkeep

# LinkedIn (personal drafts, not for the public repo)
LinkedIn/

# Personal config (untracked, kept on disk)
.zshrc
.envrc

# Set by the /run-project skill while a subagent runs
.claude/active_project

# Run logs (may contain local paths or title-level lines)
Projects/*/outputs/**/*.log
Projects/*/workflow/logs/*.log

# Title-level or individual-level outputs (aggregate files stay tracked)
Projects/netflix-engagement/outputs/profile/profile_*.json
Projects/netflix-engagement/outputs/profile/season_notation_examples.csv
Projects/netflix-engagement/outputs/profile/title_variants.csv
